;;; test-archive.el --- Archive result handling -*- lexical-binding: t -*-
(require 'ert)
(require 'cl-lib)
(require 'hl-line)
(require 'mail-app-commands)

(ert-deftest mail-app-archive-view-closes-only-on-success ()
  "Failed, skipped and unparseable archives must leave the message open."
  (dolist (result '((:ok 1 :missing 0 :failed 0 :skipped 0)
                    (:ok 0 :missing 0 :failed 1 :skipped 0)
                    (:ok 0 :missing 0 :failed 0 :skipped 1)))
    (save-window-excursion
      (with-temp-buffer
        (switch-to-buffer (current-buffer))
        (setq major-mode 'mail-app-message-view-mode)
        (setq-local mail-app-current-message-id "42")
        (let ((mail-app-gmail-archive-action 'archive)
              closed captured)
          (cl-letf (((symbol-function 'mail-app--speak) #'ignore)
                    ((symbol-function 'quit-window) (lambda (&rest _) (setq closed t)))
                    ((symbol-function 'mail-app--run-mutation-async)
                     (lambda (ids callback &rest args)
                       (setq captured (cons ids args))
                       (funcall callback result))))
            (mail-app-archive-current-message)
            (should (equal captured '(("42") "messages" "archive" :after "--gmail=archive")))
            (should (eq closed (= (plist-get result :ok) 1)))))))))

(ert-deftest mail-app-archive-unparseable-output-is-failure ()
  (let (result)
    (cl-letf (((symbol-function 'mail-app--run-command-async)
               (lambda (callback &rest _) (funcall callback "error: Accessibility denied"))))
      (mail-app--run-mutation-async '("42") (lambda (r) (setq result r)) "messages" "archive")
      (should (= (plist-get result :ok) 0))
      (should (= (plist-get result :failed) 1))
      (should (string-match-p "Accessibility denied" (mail-app--mutation-summary result "Archived"))))))

(ert-deftest mail-app-archive-reports-per-message-error ()
  (should (string-match-p "Archive disabled"
                         (mail-app--mutation-summary
                          '(:ok 0 :failed 1 :results (((error . "Archive disabled")))) "Archived"))))

(ert-deftest mail-app-archive-requests-run-in-order ()
  "A second batch waits, including when the first partially fails."
  (let (mail-app--archive-running mail-app--archive-queue calls callbacks results)
    (cl-letf (((symbol-function 'mail-app--speak) #'ignore)
              ((symbol-function 'mail-app--run-command-async)
               (lambda (callback &rest args)
                 (setq calls (append calls (list args)))
                 (setq callbacks (append callbacks (list callback))))))
      (mail-app--run-mutation-async '("1" "2") (lambda (r) (push r results)) "messages" "archive")
      (mail-app--run-mutation-async '("3") (lambda (r) (push r results)) "messages" "archive")
      (should (equal calls '(("messages" "archive" "1" "2"))))
      (should mail-app--archive-running)
      (funcall (pop callbacks) "{\"ok\":1,\"failed\":1}")
      (should (equal calls '(("messages" "archive" "1" "2") ("messages" "archive" "3"))))
      (should (= (plist-get (car results) :failed) 1))
      (funcall (pop callbacks) "{\"ok\":1,\"failed\":0}")
      (should (= (length results) 2))
      (should-not mail-app--archive-running)
      (should-not mail-app--archive-queue))))

(ert-deftest mail-app-archive-queue-recovers-from-launch-error ()
  (let (mail-app--archive-running mail-app--archive-queue result)
    (cl-letf (((symbol-function 'mail-app--run-command-async)
               (lambda (&rest _) (error "Cannot start CLI"))))
      (mail-app--run-mutation-async '("1") (lambda (r) (setq result r)) "messages" "archive")
      (should (= (plist-get result :failed) 1))
      (should-not mail-app--archive-running)
      (should-not mail-app--archive-queue))))

(ert-deftest mail-app-signaled-command-completes-callback ()
  "A killed subprocess must release queued work through its callback."
  (let (sentinel output-buffer result)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest props)
                 (setq sentinel (plist-get props :sentinel)
                       output-buffer (plist-get props :buffer))
                 'fake-process))
              ((symbol-function 'process-buffer) (lambda (_) output-buffer))
              ((symbol-function 'process-status) (lambda (_) 'signal)))
      (mail-app--run-command-async (lambda (output) (setq result output)) "messages" "archive" "1")
      (funcall sentinel 'fake-process "killed\n")
      (should (string-prefix-p "error:" result))
      (should-not (buffer-live-p output-buffer)))))

(provide 'test-archive)

(ert-deftest mail-app-archive-progress-keeps-json-clean ()
  "Partial stderr lines must not corrupt the final mutation summary."
  (let (filter sentinel buffer output stages)
    (let ((mail-app--progress-callback (lambda (stage) (push stage stages))))
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest props)
                   (setq filter (plist-get props :filter)
                         sentinel (plist-get props :sentinel)
                         buffer (plist-get props :buffer))
                   'fake-process))
                ((symbol-function 'process-buffer) (lambda (_) buffer))
                ((symbol-function 'process-status) (lambda (_) 'exit))
                ((symbol-function 'process-exit-status) (lambda (_) 0)))
        (mail-app--run-command-async (lambda (s) (setq output s)) "messages" "archive" "1")
        (funcall filter 'fake-process "mail-app-pro")
        (funcall filter 'fake-process "gress: Verifying 3 messages\n{\"ok\":3,")
        (funcall filter 'fake-process "\"failed\":0}")
        (funcall sentinel 'fake-process "finished\n")
        (should (equal stages '("Verifying 3 messages")))
        (should (= (plist-get (mail-app--parse-mutation-output output) :ok) 3))
        (should-not (string-match-p "progress" output))))))

(ert-deftest mail-app-archive-structured-failure-does-not-dump-json ()
  "Preserve the partial result without repeating raw JSON in *Messages*."
  (let (filter sentinel buffer output diagnostics)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest props)
                 (setq filter (plist-get props :filter)
                       sentinel (plist-get props :sentinel)
                       buffer (plist-get props :buffer))
                 'fake-process))
              ((symbol-function 'process-buffer) (lambda (_) buffer))
              ((symbol-function 'process-status) (lambda (_) 'exit))
              ((symbol-function 'process-exit-status) (lambda (_) 1))
              ((symbol-function 'message) (lambda (&rest args) (push args diagnostics))))
      (mail-app--run-command-async (lambda (s) (setq output s)) "messages" "archive" "1" "2")
      (funcall filter 'fake-process "{\"ok\":1,\"failed\":1}\n1 message archived, 1 failed\n")
      (funcall sentinel 'fake-process "exited abnormally\n")
      (should (= (plist-get (mail-app--parse-mutation-output output) :ok) 1))
      (should (= (plist-get (mail-app--parse-mutation-output output) :failed) 1))
      (should-not diagnostics))))

(ert-deftest mail-app-archive-partial-failure-restores-only-failed-marks ()
  (with-temp-buffer
    (setq major-mode 'mail-app-messages-mode)
    (setq-local mail-app-marked-messages '("new"))
    (mail-app--archive-result
     '(:ok 1 :failed 1 :results (((id . "1") (status . "ok"))
                                ((id . "2") (status . "failed") (error . "Still in Inbox"))))
     '("1" "2") (current-buffer))
    (should (equal mail-app-marked-messages '("new" "2")))))

(ert-deftest mail-app-archive-partial-thread-failure-retains-thread-mark ()
  (with-temp-buffer
    (setq major-mode 'mail-app-thread-list-mode)
    (setq-local mail-app-threads-data
                '((:thread-id "a" :all-messages ((:id "1") (:id "2")))
                  (:thread-id "b" :all-messages ((:id "3")))))
    (mail-app--archive-result
     '(:ok 2 :failed 1 :results (((id . "1") (status . "ok"))
                                ((id . "2") (status . "failed"))
                                ((id . "3") (status . "ok"))))
     '("1" "2" "3") (current-buffer))
    (should (equal mail-app-marked-messages '("a")))))

(ert-deftest mail-app-archive-restoration-warning-preserves-success ()
  (let ((summary (mail-app--mutation-summary
                  '(:ok 3 :failed 0 :results (((status . "ok") (warning . "Mail became active"))))
                  "Archived")))
    (should (string-match-p "Archived 3 messages" summary))
    (should (string-match-p "warning: Mail became active" summary))
    (should-not (string-match-p "failed" summary))))

(ert-deftest mail-app-refresh-retains-failed-archive-marks ()
  (with-temp-buffer
    (setq major-mode 'mail-app-messages-mode)
    (setq-local mail-app-unified-view 'inbox)
    (setq-local mail-app-marked-messages '("failed"))
    (cl-letf (((symbol-function 'mail-app--speak) #'ignore)
              ((symbol-function 'mail-app-list-inbox)
               (lambda () (kill-all-local-variables)
                 (setq major-mode 'mail-app-messages-mode))))
      (mail-app-refresh)
      (should (equal mail-app-marked-messages '("failed"))))))

(ert-deftest mail-app-archive-remaps-mark-after-thread-root-is-archived ()
  (with-temp-buffer
    (setq major-mode 'mail-app-thread-list-mode)
    (setq-local mail-app-current-account "test")
    (setq-local mail-app-current-mailbox "INBOX")
    (setq-local mail-app-marked-messages '("old-root"))
    (setq-local mail-app--archive-retry-ids '("failed-child"))
    (cl-letf (((symbol-function 'mail-app--speak) #'ignore)
              ((symbol-function 'mail-app-list-threads)
               (lambda (&rest _) (kill-all-local-variables)
                 (setq major-mode 'mail-app-thread-list-mode))))
      (mail-app-refresh))
    (mail-app--format-thread-list
     '((:thread-id "failed-child" :thread-root (:id "failed-child" :subject "Test")
        :all-messages ((:id "failed-child")) :message-count 1 :latest-sender "Sender")))
    (should (equal mail-app-marked-messages '("failed-child")))
    (should (get-text-property (point) 'mail-app-marked))
    (should-not mail-app--archive-retry-ids)))
;;; test-archive.el ends here
